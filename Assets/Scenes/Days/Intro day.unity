    - target: {fileID: 4400185810877925110, guid: de65b0e8b36c18b41bf5543670181745, type: 3}
      propertyPath: unityEvents.Array.data[0].m_PersistentCalls.m_Calls.Array.data[4].m_MethodName
      value: 
      objectReference: {fileID: 0}
    - target: {fileID: 4400185810877925110, guid: de65b0e8b36c18b41bf5543670181745, type: 3}
      propertyPath: unityEvents.Array.data[0].m_PersistentCalls.m_Calls.Array.data[1].m_TargetAssemblyTypeName
      value: ObservationGiver, Assembly-CSharp
      objectReference: {fileID: 0}
    - target: {fileID: 4400185810877925110, guid: de65b0e8b36c18b41bf5543670181745, type: 3}
      propertyPath: unityEvents.Array.data[0].m_PersistentCalls.m_Calls.Array.data[2].m_TargetAssemblyTypeName
      value: ObservationGiver, Assembly-CSharp
      objectReference: {fileID: 0}
    - target: {fileID: 4400185810877925110, guid: de65b0e8b36c18b41bf5543670181745, type: 3}
      propertyPath: unityEvents.Array.data[0].m_PersistentCalls.m_Calls.Array.data[3].m_TargetAssemblyTypeName
      value: ObservationGiver, Assembly-CSharp
      objectReference: {fileID: 0}
    - target: {fileID: 4400185810877925110, guid: de65b0e8b36c18b41bf5543670181745, type: 3}
      propertyPath: unityEvents.Array.data[0].m_PersistentCalls.m_Calls.Array.data[4].m_TargetAssemblyTypeName
      value: ObservationGiver, Assembly-CSharp
      objectReference: {fileID: 0}
    - target: {fileID: 4400185810877925110, guid: de65b0e8b36c18b41bf5543670181745, type: 3}
      propertyPath: unityEvents.Array.data[0].m_PersistentCalls.m_Calls.Array.data[0].m_Arguments.m_StringArgument
      value: 'I often grow tired of all of this talk of me being a witch. Just yesterday,
        I brought some daisies over to the apothecary, when I was being jeered at.
        Honestly, I cannot wait for the trial - it will finally bring some peace
        back to me. '
      objectReference: {fileID: 0}
    - target: {fileID: 4400185810877925110, guid: de65b0e8b36c18b41bf5543670181745, type: 3}
      propertyPath: unityEvents.Array.data[0].m_PersistentCalls.m_Calls.Array.data[1].m_Arguments.m_StringArgument
      value: Is it because I am a woman practising healing? I thought we left such
        ideals in the past. At least I know my husband and children support me; their
        help has been a welcome reprieve.
      objectReference: {fileID: 0}
    - target: {fileID: 4400185810877925110, guid: de65b0e8b36c18b41bf5543670181745, type: 3}
      propertyPath: unityEvents.Array.data[0].m_PersistentCalls.m_Calls.Array.data[2].m_Arguments.m_StringArgument
      value: ' But that woman - Jenneke - I should attempt to speak with her one
        more time. Her ailment is clouding her senses.'
      objectReference: {fileID: 0}
    - target: {fileID: 4400185810877925110, guid: de65b0e8b36c18b41bf5543670181745, type: 3}
      propertyPath: unityEvents.Array.data[0].m_PersistentCalls.m_Calls.Array.data[3].m_Arguments.m_StringArgument
      value: "I woke up in this woman\u2019s body. It seems that a trial by water
        is about to take place - I should see if I can prove my innocence in a different
        way. "
      objectReference: {fileID: 0}
    - target: {fileID: 4400185810877925110, guid: de65b0e8b36c18b41bf5543670181745, type: 3}
      propertyPath: unityEvents.Array.data[0].m_PersistentCalls.m_Calls.Array.data[4].m_Arguments.m_StringArgument
      value: 
      objectReference: {fileID: 0}
    - target: {fileID: 4400185810877925110, guid: de65b0e8b36c18b41bf5543670181745, type: 3}
